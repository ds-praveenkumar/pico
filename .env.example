# pico — environment configuration template.
# Copy to .env and fill in real values:
#     cp .env.example .env
# Never commit .env; it holds secrets and is git-ignored.

# --- Master (the person pico serves) ---
PICO_MASTER_NAME=Praveen

# --- Default provider: openai | nvidia | cerebras | groq | openrouter | evolink | unorouter | gemini | sambanova (nvidia is the default) ---
PROVIDER=nvidia

# --- OpenAI ---
# MODEL_ID=...
# API_KEY=...

# --- NVIDIA (NIM / build.nvidia.com) ---
NVIDIA_MODEL_ID=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# --- Cerebras ---
CEREBRAS_MODEL_ID=
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=

# --- Groq (GROK_* names accepted as fallback) ---
GROQ_MODEL_ID=
GROQ_API_KEY=
GROQ_BASE_URL=

# --- OpenRouter ---
OPENROUTER_MODEL_ID=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# --- EvoLink (model gateway; OpenAI-compatible) ---
EVOLINK_MODEL_ID=
EVOLINK_API_KEY=
EVOLINK_BASE_URL=                # optional; default https://direct.evolink.ai/v1

# --- UnoRouter (OpenAI-compatible gateway, free :free models) ---
UNO_ROUTER_MODEL_ID=
UNO_ROUTER_API_KEY=
UNO_ROUTER_BASE_URL=             # optional; default https://api.unorouter.com/v1

# --- Google Gemini (AI Studio; OpenAI-compatible) ---
GEMINI_MODEL_ID=
GEMINI_API_KEY=
GEMINI_BASE_URL=                 # optional; default https://generativelanguage.googleapis.com/v1beta/openai/

# --- SambaNova Cloud (fast RDU inference; OpenAI-compatible) ---
SAMBANOVA_MODEL_ID=
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=              # optional; default https://api.sambanova.ai/v1

# --- Optional: logging level and memory settings ---
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
PICO_MEMORY_PATH=~/.pico        # memory directory
PICO_COMPACTION_TOKENS=24000    # auto-compaction token threshold
PICO_FONT_SIZE=18               # TUI font size, in points (OSC 7770 terminals only)

# --- Browser hand-off (all optional; see README "Browser hand-off") ---
PICO_BROWSER_AWAIT_HUMAN=1      # wait in place for the master during a CAPTCHA/OTP/form hand-off (0 disables)
PICO_BROWSER_HANDOFF_TIMEOUT=600  # seconds pico waits for the master to finish (30-7200)
PICO_BROWSER_AUTO_SUBMIT=1      # submit the form automatically once control returns (0 disables)

# --- Gmail OAuth2 (see README "Gmail setup (OAuth2)") ---
# Path to the OAuth client secrets JSON exported from Google Cloud;
# plain path or file:// URI both work.
GMAIL_CLIENT_SECRET_PATH=file:///path/to/client_secret_xxx.apps.googleusercontent.com.json
# Optional: directory holding credentials.json and token.json (default ~/.agents/gmail).
GMAIL_CREDENTIALS_PATH=~/.agents/gmail

# --- Google Calendar OAuth2 (see README "Google Calendar setup (OAuth2)") ---
CALENDAR_CLIENT_SECRET_PATH=file:///path/to/client_secret_xxx.apps.googleusercontent.com.json
# Optional: directory holding credentials.json and token.json (default ~/.agents/calendar).
CALENDAR_CREDENTIALS_PATH=~/.agents/calendar

# --- Google Sheets OAuth2 (see README "Google Sheets setup (OAuth2)") ---
SHEETS_CLIENT_SECRET_PATH=file:///path/to/client_secret_xxx.apps.googleusercontent.com.json
# Optional: directory holding credentials.json and token.json (default ~/.agents/sheets).
SHEETS_CREDENTIALS_PATH=~/.agents/sheets

# --- Legacy IMAP (superseded by OAuth2, optional) ---
# GMAIL_IMAP_USER=you@gmail.com
# GMAIL_IMAP_PASSWORD=app-password
# GMAIL_IMAP_HOST=imap.gmail.com